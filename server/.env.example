# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file. Never commit real secrets.

# Database connection string
DATABASE_URL="postgresql://pocket48:pocket48@localhost:5432/pocket48?schema=public"

# HTTP server port
PORT=3000

# Runtime mode (development locally, production in Cloud Run)
# NODE_ENV=development

# Time zone (Asia/Bangkok required by BR-03)
# TZ=Asia/Bangkok

# Session signing secret
# SESSION_SECRET=change-me-to-a-secure-random-string

# First administrator password for seed (admin@pocket48.local)
# ADMIN_PASSWORD=change-me-admin-password

# Demo users initial password for seed
# DEMO_USER_PASSWORD=change-me-demo-password

# Seed demo transactions on startup (true locally, false in production)
# SEED_DEMO_DATA=true

# Allowed CORS origin for local frontend dev server
# CORS_ORIGIN=http://localhost:5173
