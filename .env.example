# Copy this file to ".env" at the repository root before running `docker compose up --build -d`.
# Do NOT commit your real .env file. Never commit real secrets.

# PostgreSQL container settings (used by docker-compose.yml)
POSTGRES_USER=pocket48
POSTGRES_PASSWORD=pocket48
POSTGRES_DB=pocket48

# Backend runtime settings
NODE_ENV=production
TZ=Asia/Bangkok
PORT=3000
SESSION_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
CORS_ORIGIN=http://localhost:5173

# Seed credentials for migrate service (required on first run)
ADMIN_PASSWORD=change-me-admin-password
DEMO_USER_PASSWORD=change-me-demo-password
SEED_DEMO_DATA=true
